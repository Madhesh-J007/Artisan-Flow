rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile (needed for retailer matching to see artisans),
    // but can only create/update their own document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Requests: readable by the two parties involved. Retailers can create
    // requests; either party can update status (accept/decline).
    match /requests/{requestId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.retailerId || request.auth.uid == resource.data.artisanId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.retailerId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.retailerId || request.auth.uid == resource.data.artisanId);
    }
  }
}
